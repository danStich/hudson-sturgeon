model {
  
  # Priors
  # Individual detection probability
  logit_p_mu ~ dnorm(0, 0.001)
  logit_p_tau <- 1/(logit_p_sigma * logit_p_sigma)
  logit_p_sigma ~ dunif(0, 10)

  for(i in 1:nSites){
    for(t in 1:nYears){
      for(j in 1:nReps){
        logit_p[i, t, j]  ~ dnorm(logit_p_mu, logit_p_tau)
        logit(p[i, t, j]) <- logit_p[i, t, j]
      }
    }  
  }
  
  
  # Abundance
  # Hyper priors
  log_lambda ~ dnorm(0, 0.001)
  log_lambda_tau <- 1/(log_lambda_sd * log_lambda_sd) 
  log_lambda_sd ~ dunif(0, 3) 

  for(t in 1:nYears){
    log(lambdap[t]) <- log_lambdap[t]
    log_lambdap[t] ~ dnorm(log_lambda, log_lambda_tau)
  }
  
  # Likelihood
  # State process (abundance)
  for(i in 1:nSites){
    for(t in 1:nYears){
      N[i, t] ~ dpois(lambdap[t])

    }
  }
  
  # Observation process (detection)
  for (i in 1:nSites){
  
    for (t in 1:nYears){
      for (j in 1:nReps) {  
        y[i, t, j] ~ dbin(p[i, t, j], N[i, t])
        
      }
      
    }
    
  }
  
  for(t in 1:nYears){
    n_total[t] <- sum(N[, t])
  }
  
}
